{
  "project": "neuro-assist-ai",
  "status": "draft (BA)",
  "version": "0.1.0",
  "entities": {
    "Tenant": {
      "description": "Unidade de cuidado — família ou clínica (multi-tenant, schema-per-empresa)",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "nome": {
          "type": "string"
        },
        "tipo": {
          "type": "enum",
          "enum": [
            "familia",
            "clinica"
          ]
        }
      }
    },
    "Paciente": {
      "description": "Pessoa monitorada pelo sistema",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "tenantId": {
          "type": "ref",
          "ref": "Tenant",
          "label": "nome"
        },
        "nome": {
          "type": "string"
        },
        "dispositivo": {
          "type": "ref",
          "ref": "DispositivoEdge",
          "label": "status"
        }
      }
    },
    "Cuidador": {
      "description": "Pessoa com acesso ao painel",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "tenantId": {
          "type": "ref",
          "ref": "Tenant",
          "label": "nome"
        },
        "nome": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "papel": {
          "type": "enum",
          "enum": [
            "cuidadora",
            "coordenador_clinica"
          ]
        }
      }
    },
    "TipoGesto": {
      "description": "Catálogo de tipos de movimento facial (primitivos) reconhecidos pelo motor de detecção — extensível (LBC Emenda 2, 2026-07-27). Cadastrar um nome aqui NÃO implica suporte real do motor de detecção (ver TODO[arquiteto] no Framing §6.1/§7.1a/§9.3).",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "nome": {
          "type": "string"
        }
      }
    },
    "Comando": {
      "description": "Item do catálogo de comandos do paciente — gesto (simples ou composto) mapeado a uma necessidade (LBC Emenda 1, 2026-07-27)",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "pacienteId": {
          "type": "ref",
          "ref": "Paciente",
          "label": "rotulo"
        },
        "rotulo": {
          "type": "string"
        },
        "urgencia": {
          "type": "enum",
          "enum": [
            "emergencia",
            "rotina"
          ]
        },
        "primitivoPrincipal": {
          "type": "ref",
          "ref": "TipoGesto",
          "label": "nome"
        },
        "primitivoSecundario": {
          "type": "ref",
          "ref": "TipoGesto",
          "label": "nome",
          "nullable": true
        },
        "sensibilidade": {
          "type": "enum",
          "enum": [
            "baixa",
            "media",
            "alta"
          ]
        },
        "tempoMinimoGestoMs": {
          "type": "int"
        },
        "tempoMaximoGestoMs": {
          "type": "int"
        }
      }
    },
    "Evento": {
      "description": "Ocorrência estruturada gerada pelo edge",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "pacienteId": {
          "type": "ref",
          "ref": "Paciente",
          "label": "nome"
        },
        "comando": {
          "type": "ref",
          "ref": "Comando",
          "label": "rotulo"
        },
        "timestamp": {
          "type": "datetime"
        },
        "confirmadoEm": {
          "type": "datetime",
          "nullable": true,
          "source": "mock"
        },
        "confirmadoPor": {
          "type": "ref",
          "ref": "Cuidador",
          "label": "nome"
        },
        "feedback": {
          "type": "enum",
          "enum": [
            "nao_avaliado",
            "real",
            "falso_positivo"
          ]
        }
      }
    },
    "DispositivoEdge": {
      "description": "Agente local que roda a detecção de gesto",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "pacienteId": {
          "type": "ref",
          "ref": "Paciente",
          "label": "nome"
        },
        "status": {
          "type": "enum",
          "enum": [
            "online",
            "offline"
          ]
        },
        "ultimaSincronizacao": {
          "type": "datetime"
        },
        "versao": {
          "type": "string"
        }
      }
    },
    "NoArvoreFala": {
      "description": "Nó da árvore de falas do módulo CONV — categoria ou frase (Emenda 3, 2026-08-30; ADR-013 accepted). parentId nulo = raiz da árvore. engineFeatureRef opcional referencia o vocabulário unificado de gesto (commit 89f4ee5 do repositório real, ver gest/frontend ADR-008 D4) para mapear um gesto reconhecido diretamente a um nó — sem tabela de mapeamento própria do CONV. conteudo é por locale (Emenda 4, 2026-08-31; ADR-018 accepted) — texto/áudio deixaram de ser campo único; cada locale (pt/en) tem texto, audioRef (referência ao áudio cacheado via ElevenLabs, ADR-017) e a Dupla Autorização (confirmadoCuidadora/confirmadoPaciente, ADR-016) que precisa completar antes de indexar no Elasticsearch (ADR-015).",
      "fields": {
        "id": { "type": "string", "pk": true },
        "pacienteId": { "type": "ref", "ref": "Paciente", "label": "nome" },
        "parentId": { "type": "ref", "ref": "NoArvoreFala", "label": "texto", "nullable": true },
        "tipo": { "type": "enum", "enum": ["categoria", "frase"] },
        "conteudo": {
          "type": "map",
          "keyEnum": ["pt", "en"],
          "valueFields": {
            "texto": { "type": "string" },
            "audioRef": { "type": "string", "nullable": true },
            "confirmadoCuidadora": { "type": "boolean" },
            "confirmadoPaciente": { "type": "boolean" }
          },
          "note": "Emenda 4 (2026-08-31), ADR-018 — antes era `texto: { type: string }` único (Emenda 3). Migração real: TODO[arquiteto]."
        },
        "ordem": { "type": "int" },
        "engineFeatureRef": { "type": "string", "nullable": true },
        "propostoPorTreinamento": { "type": "boolean", "note": "Emenda 4 — true se originado da LLM na fase de TREINAMENTO (ADR-016)" }
      }
    },
    "SessaoPaciente": {
      "description": "Sessão de app persistente do paciente no próprio celular, provisionada pela cuidadora — não expira, é revogável a qualquer momento (Emenda 3, 2026-08-30; ADR-012 accepted, Opção C: ator novo em acs-service, distinto de cuidador e de dispositivo edge). Revogação reaproveita o mecanismo de blacklist de JWT já existente no projeto real (rbac/session-policy.md).",
      "fields": {
        "id": { "type": "string", "pk": true },
        "pacienteId": { "type": "ref", "ref": "Paciente", "label": "nome" },
        "provisionadaPor": { "type": "ref", "ref": "Cuidador", "label": "nome" },
        "dispositivoId": { "type": "ref", "ref": "DispositivoEdge", "label": "status" },
        "status": { "type": "enum", "enum": ["ativa", "revogada"] },
        "provisionadaEm": { "type": "datetime" },
        "revogadaEm": { "type": "datetime", "nullable": true },
        "revogadaPor": { "type": "ref", "ref": "Cuidador", "label": "nome", "nullable": true }
      }
    }
  },
  "screenBindings": {
    "entrada": {
      "reads": [
        "(nenhum — tela estática",
        "sem dados operacionais)"
      ],
      "writes": [
        "(nenhum)"
      ]
    },
    "home": {
      "reads": [
        "Paciente[]",
        "DispositivoEdge[]",
        "Evento[] (do dia",
        "com `Evento.comando` resolvido para rótulo + urgência)"
      ],
      "writes": [
        "(nenhuma neste momento — leitura pura)"
      ],
      "mock": {
        "pacientes": "mock-data.json#/pacientes",
        "dispositivos": "mock-data.json#/dispositivos",
        "comandos": "mock-data.json#/comandos",
        "eventos": "mock-data.json#/eventos"
      }
    },
    "alarme": {
      "reads": [
        "Evento[] (mesma coleção do Home/Histórico; o evento ativo é o mais recente cujo `Comando.urgencia = emergencia` e ainda sem `confirmadoEm` — não é uma coleção separada)"
      ],
      "writes": [
        "Evento.confirmadoEm",
        "Evento.confirmadoPor"
      ],
      "mock": {
        "eventos": "mock-data.json#/eventos",
        "comandos": "mock-data.json#/comandos"
      }
    },
    "historico": {
      "reads": [
        "Evento[] (filtrado por período",
        "com `Evento.comando` resolvido para rótulo + urgência)"
      ],
      "writes": [
        "Evento.feedback"
      ],
      "mock": {
        "eventos": "mock-data.json#/eventos"
      }
    },
    "calibracao": {
      "reads": [
        "Comando[] (todos do paciente ativo)",
        "TipoGesto[] (catálogo extensível de primitivos, Emenda 2)"
      ],
      "writes": [
        "Comando (criar/editar/remover)",
        "campos: rotulo",
        "urgencia",
        "primitivoPrincipal",
        "primitivoSecundario",
        "sensibilidade",
        "TipoGesto (criar novo tipo — ex.: \"Leitura labial\" — direto no editor de comando)"
      ],
      "mock": {
        "comandos": "mock-data.json#/comandos",
        "tiposGesto": "mock-data.json#/tiposGesto"
      }
    },
    "onboarding": {
      "reads": [
        "Tenant[]",
        "Paciente[]",
        "DispositivoEdge[]"
      ],
      "writes": [
        "Tenant",
        "Paciente",
        "DispositivoEdge",
        "Cuidador (cria os registros)",
        "Comando (opcionalmente já cria o primeiro comando do catálogo",
        "se o condutor preencher na Tela 04 antes de voltar)"
      ]
    },
    "conv-arvore": {
      "reads": [
        "NoArvoreFala[] (filtrado por pacienteId e parentId do nível ativo)"
      ],
      "writes": [
        "(nenhuma escrita direta — seleção de nó folha pode gerar Evento se mapeado a um Comando via engineFeatureRef)"
      ],
      "mock": {
        "nosArvoreFala": "mock-data.json#/nosArvoreFala"
      }
    },
    "celular-ativacao": {
      "reads": [
        "Paciente[]",
        "DispositivoEdge[]",
        "SessaoPaciente[] (do paciente ativo)"
      ],
      "writes": [
        "SessaoPaciente (criar ao ativar; atualizar status/revogadaEm/revogadaPor ao revogar)"
      ],
      "mock": {
        "sessoesPaciente": "mock-data.json#/sessoesPaciente"
      }
    },
    "treinamento": {
      "reads": [
        "NoArvoreFala[] (filtrado por propostoPorTreinamento=true e Dupla Autorização incompleta no locale ativo)"
      ],
      "writes": [
        "NoArvoreFala (criar proposta vinda da LLM ou manual; atualizar conteudo.<locale>.confirmadoCuidadora ao aprovar)"
      ],
      "mock": {
        "nosArvoreFala": "mock-data.json#/nosArvoreFala"
      }
    },
    "confirmacao-treinamento": {
      "reads": [
        "NoArvoreFala[] (filtrado por pacienteId, conteudo.<locale>.confirmadoCuidadora=true, conteudo.<locale>.confirmadoPaciente=false)"
      ],
      "writes": [
        "NoArvoreFala.conteudo.<locale>.confirmadoPaciente (e audioRef, ao completar a Dupla Autorização — simulado no protótipo)"
      ],
      "mock": {
        "nosArvoreFala": "mock-data.json#/nosArvoreFala"
      }
    }
  }
}
