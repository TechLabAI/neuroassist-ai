{
  "name": "neuroassist-ai-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/neuroassist-ai-web/src",
  "tags": ["scope:web", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/angular:application",
      "outputs": ["{options.outputPath.base}"],
      "options": {
        "outputPath": {
          "base": "dist/apps/neuroassist-ai-web"
        },
        "index": "apps/neuroassist-ai-web/src/index.html",
        "browser": "apps/neuroassist-ai-web/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/neuroassist-ai-web/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/neuroassist-ai-web/public"
          }
        ],
        "styles": ["apps/neuroassist-ai-web/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "2mb", "maximumError": "5mb" },
            { "type": "anyComponentStyle", "maximumWarning": "6kb", "maximumError": "10kb" }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "neuroassist-ai-web:build:production"
        },
        "development": {
          "buildTarget": "neuroassist-ai-web:build:development"
        }
      },
      "defaultConfiguration": "development"
    }
  }
}
