{
  "name": "@neuroassist/edge",
  "projectType": "library",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/edge/src",
  "prefix": "edge",
  "tags": ["scope:edge", "type:feature"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/edge"],
      "options": {
        "jestConfig": "libs/edge/jest.config.js",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/edge/**/*.ts",
          "libs/edge/**/*.html"
        ]
      }
    }
  }
}
