{
  "name": "@neuroassist/hist",
  "projectType": "library",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/hist/src",
  "prefix": "hist",
  "tags": ["scope:hist", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/libs/hist"
      ],
      "options": {
        "project": "libs/hist/ng-package.json",
        "tsConfig": "libs/hist/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/hist/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/hist/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/hist"],
      "options": {
        "jestConfig": "libs/hist/jest.config.js",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/hist/**/*.ts",
          "libs/hist/**/*.html"
        ]
      }
    }
  }
}
