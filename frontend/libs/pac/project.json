{
  "name": "@neuroassist/pac",
  "projectType": "library",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/pac/src",
  "prefix": "pac",
  "tags": ["scope:pac", "type:feature"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/pac"],
      "options": {
        "jestConfig": "libs/pac/jest.config.js",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/pac/**/*.ts",
          "libs/pac/**/*.html"
        ]
      }
    }
  }
}
