{
  "name": "@neuroassist/shared-contracts",
  "projectType": "library",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/contracts/src",
  "prefix": "neuroassist",
  "tags": ["scope:shared", "type:contracts"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/shared/contracts"],
      "options": {
        "command": "npx tsc -p libs/shared/contracts/tsconfig.build.json",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
