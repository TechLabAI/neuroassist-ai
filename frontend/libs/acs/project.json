{
  "name": "@neuroassist/acs",
  "projectType": "library",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/acs/src",
  "prefix": "acs",
  "tags": ["scope:acs", "type:feature"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/acs"],
      "options": {
        "jestConfig": "libs/acs/jest.config.js",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/acs/**/*.ts",
          "libs/acs/**/*.html"
        ]
      }
    }
  }
}
