# Frontend
node_modules/
# Nx build output — scoped to frontend/dist/ so it does NOT match a
# frontend module named `dist` (e.g. libs/dist/, a source library).
frontend/dist/
.nx/

# Autopilot checkpoints (ephemeral runtime state — F-CKPT, D-326)
tmp/be-architecture-autopilot/
tmp/fe-architecture-autopilot/

# Ephemeral runtime/observability state — trace context (F2, D-423),
# runtime learning signals + token-usage JSONL (techlab-runtime).
# Surgical: other .techlab/ artifacts (e.g. assembly-*.json) stay tracked.
.techlab/trace-context.json
.techlab/learning/
.techlab/token-usage/
frontend/.techlab/trace-context.json

# Angular/Nx local caches and test/build output (never tracked)
frontend/.angular/
frontend/coverage/
frontend/test-results/
frontend/libs/dist/

# Secrets (mantém os .example)
.env.*
!.env.example
*.pem
*.key

# Ephemeral pipeline output and local config — regenerated or machine-specific,
# not part of the source under review.
tmp/
_inbox/
auxil/
.mcp.json
.techlab/*.json

# Derived issue state — recomputed from the code on each validation run.
docs/architecture/**/*.state.json
docs/architecture/**/*.checklist.json
docs/architecture/**/*.soft.json
docs/architecture/**/*.plan-state.json

# Pipeline progress journals, build logs and local outputs
project-journal.md
project-checklist.md
architecture.lock
/clean-build.log
/test-output.txt
/project-tree.html

