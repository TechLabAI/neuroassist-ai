# gest-service — variáveis de ambiente para setup local
# Copie para .env e ajuste os valores conforme seu ambiente.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gest_db
DB_USERNAME=gest_user
DB_PASSWORD=gest_pass

EUREKA_URL=http://localhost:8761/eureka
SPRING_PROFILES_ACTIVE=dev

OAUTH2_ISSUER_URI=http://localhost:9000

ARTEMIS_HOST=localhost
ARTEMIS_PORT=61616
ARTEMIS_USER=admin
ARTEMIS_PASSWORD=admin

RESILIENCE4J_CB_SLIDING_WINDOW_SIZE=10
RESILIENCE4J_CB_FAILURE_RATE_THRESHOLD=50
RESILIENCE4J_CB_WAIT_DURATION_OPEN=30s
