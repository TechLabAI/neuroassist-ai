    "bodyPatterns": [
      {
        "matchesJsonPath": "$.urgencia",
        "contains": "rotina"
      }
    ]
  },
  "response": {
    "status": 503,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
